# Application Settings
APP_NAME=Enterprise AI Knowledge Assistant
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long
BACKEND_CORS_ORIGINS=["http://localhost:8501","http://localhost:3000","http://127.0.0.1:8501"]

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_knowledge_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rag_knowledge_db

# JWT Authentication
JWT_SECRET_KEY=change-this-super-secret-jwt-key-min-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ROUTER_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2048

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=enterprise_knowledge_base
QDRANT_API_KEY=

# Document Ingestion & Chunking
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval & Hybrid Search
DENSE_TOP_K=20
SPARSE_TOP_K=20
FUSED_TOP_K=20
RERANK_TOP_K=8

# Reranker Model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Corrective RAG
MAX_RETRIEVAL_ATTEMPTS=2
RELEVANCE_THRESHOLD=0.6

# Conversation Memory
MAX_HISTORY_MESSAGES=10
